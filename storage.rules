rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for all files (portfolio images/videos are public)
    // Write restricted to admin only
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'daniansyahchusyaidin@gmail.com';
    }
  }
}
